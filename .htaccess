# gundogdu-site
DirectoryIndex index.php
Options -Indexes
ErrorDocument 404 /404.php
# The pre-Studio canonical adapter may remain as dormant files on a staging
# site during transfer. Never expose its implementation/config via HTTP.
RewriteEngine On
RewriteRule ^(?:core|site|public|locales|tools|canonical|docs|config|storage)(?:/|$) - [F,L]
RewriteRule ^(?:template-manifest\.json|README\.md)$ - [F,L]
RewriteRule ^yardimci-asistan/(?:config|data|lib|knowledge)(?:/|$) - [F,L]
RewriteRule (^|/)\. - [F,L]
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<FilesMatch "^(?:README\.md|.*\.local.*|\.env.*)$">
  Require all denied
</FilesMatch>

# Exported Studio scenes must refresh immediately after installation.
<IfModule mod_headers.c>
  <FilesMatch "^hero(?:\.sample)?\.scene\.json$">
    Header always set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType text/javascript .mjs
</IfModule>
