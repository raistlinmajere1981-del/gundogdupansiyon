# gundogdu-site
DirectoryIndex index.php
Options -Indexes
# Canonical implementation and preserved independent runtime stay HTTP-private.
RewriteEngine On
RewriteRule ^(?:core|site|public|locales|tools|canonical|inc|scripts|tests|docs|config|storage)(?:/|$) - [F,L,NC]
RewriteRule ^assets/(?:js|css|assistant|i18n|effect-engine|effects|vendor/pannellum)(?:/|$) - [F,L,NC]
RewriteRule ^(?:404|router)\.php$ - [F,L,NC]
RewriteRule ^(?:template-manifest\.json|README\.md)$ - [F,L,NC]
RewriteRule ^yardimci-asistan/(?:config|data|lib|knowledge)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\. - [F,L,NC]
RewriteRule ^sitemap\.xml$ index.php?resource=sitemap [QSA,L]
RewriteCond %{REQUEST_URI} !^/yardimci-asistan(?:/|$)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<FilesMatch "^(?:README\.md|.*\.local.*|\.env.*)$">
  Require all denied
</FilesMatch>

# Exported Studio scenes must refresh immediately after installation.
<IfModule mod_headers.c>
  <FilesMatch "^hero(?:\.sample)?\.scene\.json$">
    Header always set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType text/javascript .mjs
</IfModule>
